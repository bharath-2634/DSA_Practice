Question: https://codeforces.com/problemset/problem/157/A

solution:

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[][] grid = new int[n][n];

        for(int i=0;i<n;i++) {
            for(int j=0;j<n;j++) {
                grid[i][j] = sc.nextInt();
            }
        } 

        int count=0;
        for(int i=0;i<n;i++) {
            for(int j=0;j<n;j++) {
                int sum_col = 0;
                for(int col=0;col<n;col++) {
                    sum_col+=grid[col][j];
                }

                int sum_row=0;
                for(int row=0;row<n;row++) {
                    sum_row+=grid[i][row];
                }

                if(sum_col>sum_row) {
                    count++;
                }
            }
        }

        System.out.println(count);
    }
}
