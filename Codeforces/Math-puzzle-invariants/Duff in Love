        long answer=1;

        for(long p=2;p*p<=n;p++) {
            if(n%p==0) {
                answer*=p;
                while(n%p==0) {
                    n/=p;
                }
            }
        }

        if(n>1) {
            answer*=n;
        }

        System.out.println(answer);
