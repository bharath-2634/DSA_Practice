Question: https://codeforces.com/problemset/problem/588/B

Solution:
import java.util.*;


public class Main {

    public static boolean isSquareFreeNumber(long n) {
        if(n<0) return false;
        
        if(n==1) return true;
        
        if(n%4==0) return false;

        long i=3;
        while(i*i<=n) {
            if(n%(i*i)==0) return false;
            i+=2;
        }

        return true;
    }

