Problem: https://codeforces.com/problemset/problem/2063/A

Solution:
import java.util.*;

class Main {


    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        while(t-->0) {
            int l = sc.nextInt();
            int r = sc.nextInt();

            int number_segments = (r-l+1)-1;
            
            if(l==r) {
                if(l==1) {
                    System.out.println("1");
                }else {
                    System.out.println("0");
                }
            }else {
                System.out.println(number_segments);
            }
        }
    }
    
}
