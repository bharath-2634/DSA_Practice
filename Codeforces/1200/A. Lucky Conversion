Question: https://codeforces.com/problemset/problem/145/A

Solution:

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String a = sc.next();
        String b = sc.next();

        int count47 = 0;
        int count74 = 0;

        for (int i = 0; i < a.length(); i++) {
            if (a.charAt(i) == '4' && b.charAt(i) == '7') {
                count47++;
            } else if (a.charAt(i) == '7' && b.charAt(i) == '4') {
                count74++;
            }
        }

        System.out.println(Math.max(count47, count74));
    }
}
