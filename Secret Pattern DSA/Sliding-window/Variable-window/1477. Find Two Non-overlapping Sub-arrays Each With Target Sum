Question: https://leetcode.com/problems/find-two-non-overlapping-sub-arrays-each-with-target-sum/

Solution:
class Solution {
    public int minSumOfLengths(int[] nums, int target) {
        int left=0,right=0,count=0,curr_sum=0;
        int min_len=Integer.MAX_VALUE;
        int[] lens = new int[nums.length];
        Arrays.fill(lens, Integer.MAX_VALUE);
        int best_len=Integer.MAX_VALUE; 

        while(right<nums.length) {
            curr_sum+=nums[right];

            while(curr_sum>target) {
                curr_sum-=nums[left];
                left++;
            }

            if(curr_sum==target) {
                if(left>0 && lens[left-1]!=Integer.MAX_VALUE) {
                    min_len = Math.min(min_len,(right-left+1)+lens[left-1]);
                }
                best_len = Math.min(best_len,(right-left+1));
            }

            lens[right] = best_len;
            right++;
        }
        return min_len==Integer.MAX_VALUE ? -1 : min_len;
    }
}

