    public int characterReplacement(String s, int k) {
        int left=0,right=0,max_len=0,max_freq=0;
        int[] freq = new int[126];

        while(right<s.length()) {
            char curr_node= s.charAt(right);
            freq[curr_node]++;
            max_freq = Math.max(max_freq,freq[curr_node]);
            int max_replacement = (right-left+1) - max_freq;

            while(max_replacement>k) {
                char left_node = s.charAt(left);
                left++;
                freq[left_node]--;
                max_replacement = (right-left+1) - max_freq;
            }

            max_len = Math.max(max_len,(right-left+1));
            right++;
        }

        return max_len;
    }
}
