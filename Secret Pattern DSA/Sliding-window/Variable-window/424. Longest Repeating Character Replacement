        Set<Character> targets = new HashSet<>();
        for(char c : s.toCharArray()) {
            targets.add(c);
        }

        for(char c : targets) {
            int left=0,right=0,flips=0,same=0,max_len=0;
            char se = c;
            while(right<s.length()) {
                char curr_node = s.charAt(right);

                if(curr_node!=se) {
                    flips++;
                }

                while(flips>k) {
                    char fo_node = s.charAt(left);
                    if(fo_node!=se) {
                        flips--;
                    }
                    same--;
                    left++;
                }

                same++;
