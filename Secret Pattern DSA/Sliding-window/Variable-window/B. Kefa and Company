Question: https://codeforces.com/problemset/problem/580/B

Solution:

import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int d = sc.nextInt();
		
		long[][] frds = new long[n][2];
		for(int i=0;i<n;i++) {
		    frds[i][0] = sc.nextLong();
		    frds[i][1] = sc.nextLong();
		}
		
		Arrays.sort(frds,(a,b) -> Long.compare(a[0],b[0]));
		
		int left=0,right=0;
		long max_score=0,curr_sum=0;
		long max_fr=0,min_fr= Long.MAX_VALUE;
		while(right<n) {
		    long curr_val = frds[right][1];
		    curr_sum+=curr_val;
		  //  max_fr = Math.max(max_fr,frds[right][0]);
		  //  min_fr= Math.min(min_fr,frds[right][0]);
		    
		    // shrinking condition
		    /*
		        max(frds[i][0]) - min(frds[i][0]) >=d
		    */
		    while((frds[right][0] - frds[left][0])>=d && left<right) {
		      //  int st_fr = frds[left][0];
		      //  // I've to re-arrange on min and max after shrinking
		      //  min_fr = n+1;
		      //  max_fr=0;
		      //  for(int i=left;i<=right;i++) {
		      //      min_fr = Math.min(min_fr,frds[i][0]);
		      //      max_fr = Math.max(max_fr,frds[i][0]);
		      //  }
		        
		        curr_sum-=frds[left][1];
		        left++;
		    }
		    
		    max_score= Math.max(max_score,curr_sum);
		    right++;
		}
		
		System.out.println(max_score);
	}
}
