Question: https://codeforces.com/problemset/problem/279/B

Solution:
import java.util.*;

public class Main {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int t = sc.nextInt();
        int[] nums = new int[n];

        for(int i=0;i<n;i++) {
            nums[i] = sc.nextInt();
        }

        int right=0,left=0,max_len=0,curr_count=0;

        while(right<nums.length) {
            curr_count+=nums[right];

            //shrink
            while(curr_count>t) {
                curr_count-=nums[left];
                left++;
            }

            max_len = Math.max(max_len,(right-left+1));
            right++;
        }

        System.out.println(max_len);
    }
}
