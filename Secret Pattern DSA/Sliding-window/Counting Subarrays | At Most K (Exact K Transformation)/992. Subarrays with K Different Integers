Question: https://leetcode.com/problems/subarrays-with-k-different-integers/

Solution:
class Solution {

    public int count(int[] nums,int k) {
        if(k<1) return 0;
        Map<Integer,Integer> fMap = new HashMap<>();

        int left=0,right=0,total_count=0;
        while(right<nums.length) {
            int curr_node = nums[right];
            fMap.put(nums[right],fMap.getOrDefault(nums[right],0)+1);

            while(fMap.size()>k) {
                int left_node= nums[left];
                fMap.put(left_node,fMap.get(left_node)-1);
                if(fMap.get(left_node)==0) {
                    fMap.remove(left_node);
                }

                left++;
            }

            total_count+=(right-left+1);
            right++;
        }

        return total_count;
    }

    public int subarraysWithKDistinct(int[] nums, int k) {
        return count(nums,k) - count(nums,k-1);
    }
}
