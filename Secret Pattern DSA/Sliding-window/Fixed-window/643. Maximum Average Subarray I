Question: https://leetcode.com/problems/maximum-average-subarray-i/

Solution:
class Solution {
    public double findMaxAverage(int[] nums, int k) {
        double max_avg=0;
        int sum=0;
        for(int i=0;i<k;i++) {
            sum+=nums[i];
        }
        // double cur_avg = sum/k;
        max_avg = sum;

        for(int i=k;i<nums.length;i++) {
            sum+=nums[i];
            sum-=nums[i-k];
            // cur_avg = sum/k;
            max_avg = Math.max(max_avg,sum);
        }

        return max_avg/k;
    }
}
