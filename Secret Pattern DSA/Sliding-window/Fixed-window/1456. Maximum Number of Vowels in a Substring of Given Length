    public int maxVowels(String s, int k) {
        int start=0,end=k;
        int count=0;
        for(int i=0;i<k;i++) {
            char c = s.charAt(i);
            if(c=='a' || c=='e' || c=='i' || c=='o' || c=='u') {
                count++;
            }
        }

        if(k==1 && (s.charAt(0)=='a' || s.charAt(0)=='e' || s.charAt(0)=='i' || s.charAt(0)=='o' || s.charAt(0)=='u' )) {
            return 1;
        }

        int max_count= count;
        while(end<s.length()) {
            char c = s.charAt(end);
            
            if(c=='a' || c=='e' || c=='i' || c=='o' || c=='u') {
                count++;
            }

            char a = s.charAt(start);
            if(a=='a' || a=='e' || a=='i' || a=='o' || a=='u') {
                count--;
            }
            
            max_count = Math.max(max_count,count);
            start++;
            end++;
        }

        return max_count==Integer.MIN_VALUE ? 0 : max_count;
    }
}
