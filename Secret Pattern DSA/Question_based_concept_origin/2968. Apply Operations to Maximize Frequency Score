    public int maxFrequencyScore(int[] nums, long k) {
        Arrays.sort(nums);
        long[] prefix = new long[nums.length+1];
        // prefix[0] = nums[0];
        for(int i=0;i<nums.length;i++) {
            prefix[i+1] = prefix[i]+nums[i];
        }
        int max_freq=0;
        int left=0,right=0;
        while(right<nums.length) {
            // right++;
            // find median
            int med_idx = (right+left)/2;
            long median = nums[med_idx];

            // calculate the cost
            long left_sum = (prefix[med_idx] - prefix[left]);
            long right_sum = (prefix[right+1] - prefix[med_idx+1]);
            long cost = (median*(med_idx - left) - left_sum) + (right_sum - median*(right-med_idx));

            //shrinking condition
            while(cost>k && left<right) {
                left++;
                med_idx = (right+left)/2;
                median = nums[med_idx];
                left_sum = (prefix[med_idx] - prefix[left]);
                right_sum = (prefix[right+1] - prefix[med_idx+1]);
                cost = (median*(med_idx - left) - left_sum) + (right_sum - median*(right-med_idx));
            }
            
            max_freq = Math.max(max_freq,(right-left+1));
            right++;
        }

        return max_freq;
    }
}

