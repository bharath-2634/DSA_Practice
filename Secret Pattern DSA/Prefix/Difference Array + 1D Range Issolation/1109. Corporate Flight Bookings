Question: https://leetcode.com/problems/corporate-flight-bookings/

Solution:
class Solution {
    public int[] corpFlightBookings(int[][] bookings, int n) {
        int[] diff = new int[n+1];
        Arrays.fill(diff,0);
        for(int[] booking: bookings) {
            int l = booking[0]-1;
            int r = booking[1]-1;
            int seats = booking[2];
            diff[l]+=seats;
            diff[r+1]-=seats;
        }

        int[] prefix = new int[n];
        int curr_freq=0;
        for(int i=0;i<n;i++) {
            curr_freq+=(diff[i]);
            prefix[i] = curr_freq;
        }

        return prefix;
    }
}
