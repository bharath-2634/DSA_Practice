    public int minMoves(int[] nums, int limit) {

        int[] diff = new int[2*limit+2];
        int left=0,right=nums.length-1;
        while(left<right) {
            int a = Math.min(nums[left],nums[right]);
            int b = Math.max(nums[right],nums[left]);

            // assuming every pair has 2 moves
            diff[2]+=2;
            // one move range -> 
            diff[a+1]--;
            diff[b+limit+1]++;
            // zero moves required
            diff[a+b]--;
            diff[a+b+1]++;

            left++;
            right--;
        }

        int min_moves=Integer.MAX_VALUE;
        int curr_moves=0;
        for(int target=2;target<=2*limit;target++) {
            curr_moves+=diff[target];
            min_moves= Math.min(min_moves,curr_moves);
        }

        return min_moves;
    }
}

