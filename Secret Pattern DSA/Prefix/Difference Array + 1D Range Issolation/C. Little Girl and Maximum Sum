    public static int calc(int[] prefix,int[][] queries) {
        int curr_total=0;
        for(int[] query: queries) {
            int l = query[0], r = query[1];
            if(l==0) {
                curr_total+=(prefix[r]);
                continue;
            }
            curr_total+=(prefix[r]-prefix[l-1]);
        }

        return curr_total;
    }

