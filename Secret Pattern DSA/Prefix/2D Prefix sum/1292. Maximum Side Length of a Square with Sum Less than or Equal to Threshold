Question: https://leetcode.com/problems/maximum-side-length-of-a-square-with-sum-less-than-or-equal-to-threshold/

Solution:
class Solution {
    public int maxSideLength(int[][] mat, int threshold) {
        int n = mat.length,m=mat[0].length;
        int[][] pre = new int[n+1][m+1];
        for(int i=0;i<n;i++) {
            for(int j=0;j<m;j++) {
                pre[i+1][j+1] = mat[i][j] + pre[i+1][j] + pre[i][j+1] - pre[i][j];
            }
        }
        
        int max_len=0;

        for(int i=1;i<=n;i++) {
            for(int j=1;j<=m;j++) {
                int r2=i,c2=j;
                int r1=i-(max_len+1);
                int c1 = j-(max_len+1);
                if(r1>=0 && c1>=0) {
                    int ans = pre[r2][c2] - pre[r1][c2] - pre[r2][c1] + pre[r1][c1];

                    if(ans<=threshold) {
                        max_len++;
                    }
                }
            }
            // System.out.println("");
        }

        return max_len;
    }
}
