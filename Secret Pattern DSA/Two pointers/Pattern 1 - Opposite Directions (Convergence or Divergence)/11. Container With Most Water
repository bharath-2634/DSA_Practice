Question: https://leetcode.com/problems/container-with-most-water/description/

solution:
class Solution {
    public int maxArea(int[] height) {
        int left=0,right=height.length-1;
        int max_area=0;

        while(left<right) {
            // calculate the area for this current space
            int min_height= Math.min(height[left],height[right]);
            int dist = right-left;
            int area = min_height*dist;
            max_area= Math.max(max_area,area);

            // one way of doing it 
            // if(height[left]<=height[right]) {
            //     left++;
            // }else if(height[right]<height[left]) {
            //     right--;
            // }

            // next better way is to use sliding-window:
            while(left<right && height[left]<=min_height) {
                left++;
            }

            while(right>left && height[right]<=min_height) {
                right--;
            }
            
        }

        return max_area;
    }
}
