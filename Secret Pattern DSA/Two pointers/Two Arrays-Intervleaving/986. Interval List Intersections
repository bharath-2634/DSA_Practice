class Solution {
    public int[][] intervalIntersection(int[][] firstList, int[][] secondList) {
        List<List<Integer>> res = new ArrayList<>();
        int idx1 = 0, idx2 = 0;

        while (idx1 < firstList.length && idx2 < secondList.length) {

            int[] first_card = firstList[idx1];
            int[] second_card = secondList[idx2];

            // No intersection
            if (first_card[0] > second_card[1]) {
                idx2++;
                continue;
            }

            if (first_card[1] < second_card[0]) {
                idx1++;
                continue;
            }

            // Intersection
            List<Integer> ds = new ArrayList<>();

            int start = Math.max(first_card[0], second_card[0]);
            int end = Math.min(first_card[1], second_card[1]);

            ds.add(start);
            ds.add(end);

            res.add(ds);

            // Move the interval that ends first
            if (first_card[1] < second_card[1]) {
                idx1++;
            } else {
                idx2++;
            }
        }

        int[][] final_res = new int[res.size()][2];

        for (int i = 0; i < res.size(); i++) {
            final_res[i][0] = res.get(i).get(0);
            final_res[i][1] = res.get(i).get(1);
        }

        return final_res;
    }
}
