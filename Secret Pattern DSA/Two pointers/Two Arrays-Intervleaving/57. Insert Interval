Question: https://leetcode.com/problems/insert-interval/


Solution:
class Solution {

    public static int[][] addToLast(int[][] intervals,int[] newInterval) {
        int[][] res = new int[intervals.length+1][2];

        for(int i=0;i<intervals.length;i++) {
            res[i][0] = intervals[i][0];
            res[i][1] = intervals[i][1];
        }

        res[res.length-1][0] = newInterval[0];
        res[res.length-1][1] = newInterval[1];

        Arrays.sort(res,(a,b)->a[0]-b[0]);

        return res;
    }

    public int[][] insert(int[][] intervals, int[] newInterval) {
        if(intervals.length==0) {
            int[][] new_intervals = new int[1][2];
            new_intervals[0][0] = newInterval[0];
            new_intervals[0][1] = newInterval[1];

            return new_intervals;
        }
        
        boolean used = false;

        for(int i=0;i<intervals.length;i++) {
            int start = intervals[i][0], end = intervals[i][1];

            if(start>newInterval[1]) continue;

            if(end>newInterval[0]) {
                start = Math.min(newInterval[0],start);
                end = Math.max(newInterval[1],end);
                intervals[i][0] = start;
                intervals[i][1] = end;
                used = true;
                break;
            }
        }

        
        if(!used) {
            // add it to the last and sort the new array and return it
            int[][] extra_intervals = addToLast(intervals,newInterval);

            // perform merge intervals
            int start = extra_intervals[0][0], end = extra_intervals[0][1];
            List<int[]> res =new ArrayList<>();

            for(int i=1;i<extra_intervals.length;i++) {
                int[] block = extra_intervals[i];

                if(end<block[0]) {
                    res.add(new int[]{start,end});
                    start = block[0];
                    end = block[1];
                }else {
                    end = Math.max(end,block[1]);
                }
            }

            res.add(new int[]{start,end});

            int[][] new_intervals = new int[res.size()][2];
            for(int i=0;i<res.size();i++) {
                new_intervals[i][0] = res.get(i)[0];
                new_intervals[i][1] = res.get(i)[1];
            }

            return new_intervals;
        }else {
            // perform merge intervals
            int start = intervals[0][0], end = intervals[0][1];
            List<int[]> res =new ArrayList<>();

            for(int i=1;i<intervals.length;i++) {
                int[] block = intervals[i];

                if(end<block[0]) {
                    res.add(new int[]{start,end});
                    start = block[0];
                    end = block[1];
                }else {
                    end = Math.max(end,block[1]);
                }
            }

            res.add(new int[]{start,end});

            int[][] new_intervals = new int[res.size()][2];
            for(int i=0;i<res.size();i++) {
                new_intervals[i][0] = res.get(i)[0];
                new_intervals[i][1] = res.get(i)[1];
            }

            return new_intervals;
        }
    }
}
