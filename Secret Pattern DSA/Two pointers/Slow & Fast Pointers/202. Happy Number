Question: https://leetcode.com/problems/happy-number/

Solution:
class Solution {

    public int square(int n) {
        int res=0;

        while(n>0) {
            int rem = n%10;
            res+=(rem*rem);
            n/=10;
        }

        return res;
    }

    public boolean isHappy(int n) {
        int slow=n,fast=n;

        do {
            slow = square(slow);
            fast = square(square(fast));
        }while(slow!=fast);

        return slow==1;
    }
}
