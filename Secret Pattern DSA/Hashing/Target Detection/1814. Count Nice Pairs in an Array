Question: https://leetcode.com/problems/count-nice-pairs-in-an-array/

Solution:

class Solution {

    public int rev(int num) {
        int res=0;
        while(num>0) {
            int temp = num%10;
            res = res*10+temp;
            num/=10;
        }

        return res;
    }

    public int countNicePairs(int[] nums) {
        Map<Integer,Integer> fMap = new HashMap<>();
        long count=0;

        int[] rever = new int[nums.length];
        for(int i=0;i<nums.length;i++) {
            rever[i] = rev(nums[i]);
        }
        
        for(int i=0;i<nums.length;i++) {
            int key = nums[i] - rever[i];

            if(fMap.containsKey(key)) {
                count = (count+fMap.get(key))%1_000_000_007;
            }
            fMap.put(key,fMap.getOrDefault(key,0)+1);
        }

        return (int)count%1_000_000_007;
    }
}

