Question: https://leetcode.com/problems/k-diff-pairs-in-an-array/

Solution:
class Solution {
    public int findPairs(int[] nums, int k) {
        Map<Integer,Integer> fMap = new HashMap<>();
        int count=0;
        Set<String> seen = new HashSet<>();
        for(int num : nums) {
            if(fMap.containsKey(k+num)) {
                String pair_1 = num+"|"+(num+k);
                String pair_2 = (num+k)+"|"+num;
                if(!seen.contains(pair_1) && !seen.contains(pair_2)) {
                    count++;
                    seen.add(pair_1);
                    seen.add(pair_2);
                }
                
            }
            if(fMap.containsKey(num-k)) {
                String pair_1 = num+"|"+(num-k);
                String pair_2 = (num-k)+"|"+num;
                if(!seen.contains(pair_1) && !seen.contains(pair_2)) {
                    count++;
                    seen.add(pair_1);
                    seen.add(pair_2);
                }
            }
            fMap.put(num,fMap.getOrDefault(num,0)+1);
        }

        return count;
    }
}
