Question: https://leetcode.com/problems/minimum-cost-tree-from-leaf-values/

Solution:
class Solution {

    public int getMax(int start,int end,int[] arr) {
        
        int max = Integer.MIN_VALUE;

        for(int i=start;i<=end;i++) {
            max = Math.max(max,arr[i]);
        }

        return max;
    }

    public int getMCT(int l,int r,int[] arr,int[][] dp) {
        if(l>=r) return 0;

        if(dp[l][r]!=-1) return dp[l][r];

        int min_sum = Integer.MAX_VALUE;

        for(int k=l;k<r;k++) {
            int left_max = getMax(l,k,arr);
            int right_max = getMax(k+1,r,arr);
            int non_leaf_val = left_max*right_max;

            min_sum = Math.min(min_sum,non_leaf_val+getMCT(l,k,arr,dp)+getMCT(k+1,r,arr,dp));
        }

        return dp[l][r] = min_sum;
    }

    public int mctFromLeafValues(int[] arr) {
        int[][] dp = new int[arr.length][arr.length];
        for(int[] d : dp) Arrays.fill(d,-1);
        
        return getMCT(0,arr.length-1,arr,dp);
    }
}
